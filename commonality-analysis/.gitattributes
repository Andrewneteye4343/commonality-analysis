# 統一換行：程式與 SQL 一律 LF（避免 Windows CRLF 讓 shell script 在容器內失效）
* text=auto eol=lf

*.py   text eol=lf
*.sql  text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows 批次檔保留 CRLF
*.bat  text eol=crlf
*.ps1  text eol=crlf

# 二進位／資料檔
*.png  binary
*.jpg  binary
*.zip  binary
*.csv  binary
*.parquet binary

# 讓 GitHub 語言統計正確（不把 notebook 當成主要語言）
*.ipynb linguist-detectable=false
